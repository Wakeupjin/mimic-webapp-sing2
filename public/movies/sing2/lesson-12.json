      "start": "01:33:38,703",
      "end": "01:33:40,638",
      "text": "Clay, you back here?"
    },
    {
      "start": "01:33:40,672",
      "end": "01:33:42,306",
      "text": "We're on next."
    },
    {
      "start": "01:33:43,574",
      "end": "01:33:45,510",
      "text": "You okay?"
    },
    {
      "start": "01:33:45,543",
      "end": "01:33:47,278",
      "text": "Uh-huh."
    },
    {
      "start": "01:33:47,311",
      "end": "01:33:49,914",
      "text": "Mission report."
    },
    {
      "start": "01:33:49,947",
      "end": "01:33:51,983",
      "text": "We have survived the wormhole."
    },
    {
      "start": "01:33:52,016",
      "end": "01:33:54,352",
      "text": "- Yeah! - Yeah."
    },
    {
      "start": "01:33:54,385",
      "end": "01:33:57,522",
      "text": "And arrived on the last planet."
    },
    {
      "start": "01:33:57,555",
      "end": "01:34:00,458",
      "text": "The missing space explorer must be here somewhere,"
    },
    {
      "start": "01:34:00,491",
      "end": "01:34:03,795",
      "text": "but there's no sign of life on my scanner."
    },
    {
      "start": "01:34:03,828",
      "end": "01:34:05,697",
      "text": "That's your cue."
    },
    {
      "start": "01:34:05,730",
      "end": "01:34:07,632",
      "text": "Clay, it's time to go on."
    },
    {
      "start": "01:34:07,665",
      "end": "01:34:10,001",
      "text": "But I see no signs of life."
    },
    {
      "start": "01:34:10,034",
      "end": "01:34:12,770",
      "text": "Nothing but an empty cave."
    },
    {
      "start": "01:34:12,804",
      "end": "01:34:14,439",
      "text": "- Clay. - Oh, no."
    },
    {
      "start": "01:34:14,472",
      "end": "01:34:16,841",
      "text": "It's okay. Just sing."
    },
    {
      "start": "01:34:16,874",
      "end": "01:34:19,343",
      "text": "- Your songs will carry you. - No."
    },
    {
      "start": "01:34:19,377",
      "end": "01:34:21,312",
      "text": "- This is a mistake. - Please."
    },
    {
      "start": "01:34:21,345",
      "end": "01:34:23,514",
      "text": "It's been so long."
    },
    {
      "start": "01:34:24,549",
      "end": "01:34:25,883",
      "text": "I'm not ready."
    },
    {
      "start": "01:34:25,917",
      "end": "01:34:27,719",
      "text": "I'm sorry."
    },
    {
      "start": "01:34:27,752",
      "end": "01:34:29,754",
      "text": "I'm not ready."
    },
    {
      "start": "01:34:46,337",
      "end": "01:34:49,040",
      "text": "♪ I have climbed ♪"
    },
    {
      "start": "01:34:49,074",
      "end": "01:34:52,744",
      "text": "♪ The highest mountains ♪"
    },
    {
      "start": "01:34:52,777",
      "end": "01:34:55,480",
      "text": "♪ I have run ♪"
    },
    {
      "start": "01:34:55,513",
      "end": "01:34:58,316",
      "text": "♪ Through the fields ♪"
    },
    {
      "start": "01:34:58,349",
      "end": "01:35:01,786",
      "text": "♪ Only to be with you ♪"
    },
    {
      "start": "01:35:02,854",
      "end": "01:35:07,258",
      "text": "♪ Only to be with you ♪"
    },
    {
      "start": "01:35:10,428",
      "end": "01:35:15,900",
      "text": "♪ But I still haven't found ♪"
    },
    {
      "start": "01:35:15,933",
      "end": "01:35:20,438",
      "text": "♪ What I'm looking for ♪"
    },
    {
      "start": "01:35:21,672",
      "end": "01:35:27,345",
      "text": "♪ But I still haven't found ♪"
    },
    {
      "start": "01:35:27,378",
