      "text": "♪ What I'm looking for ♪"
    },
    {
      "start": "01:35:32,416",
      "end": "01:35:37,922",
      "text": "♪ But I still haven't found ♪"
    },
    {
      "start": "01:35:37,955",
      "end": "01:35:42,660",
      "text": "♪ What I'm looking for ♪"
    },
    {
      "start": "01:36:09,053",
      "end": "01:36:11,522",
      "text": "♪ I believe ♪"
    },
    {
      "start": "01:36:11,556",
      "end": "01:36:13,925",
      "text": "♪ In the kingdom come ♪"
    },
    {
      "start": "01:36:13,958",
      "end": "01:36:15,860",
      "text": "♪ Then all the colors ♪"
    },
    {
      "start": "01:36:15,893",
      "end": "01:36:18,830",
      "text": "♪ Will bleed into one ♪"
    },
    {
      "start": "01:36:18,863",
      "end": "01:36:23,068",
      "text": "♪ Bleed into one ♪"
    },
    {
      "start": "01:36:23,101",
      "end": "01:36:26,838",
      "text": "♪ But yes, I'm still running ♪"
    },
    {
      "start": "01:36:27,872",
      "end": "01:36:29,607",
      "text": "♪ You broke the bonds ♪"
    },
    {
      "start": "01:36:29,640",
      "end": "01:36:32,577",
      "text": "♪ And you loosed the chains ♪"
    },
    {
      "start": "01:36:32,610",
      "end": "01:36:35,413",
      "text": "♪ Carried the cross ♪"
    },
    {
      "start": "01:36:35,446",
      "end": "01:36:40,918",
      "text": "♪ Of my shame, of my shame ♪"
    },
    {
      "start": "01:36:42,154",
      "end": "01:36:45,389",
      "text": "♪ You know I believe it ♪"
    },
    {
      "start": "01:36:47,425",
      "end": "01:36:51,996",
      "text": "♪ But I still haven't found ♪"
    },
    {
      "start": "01:36:52,029",
