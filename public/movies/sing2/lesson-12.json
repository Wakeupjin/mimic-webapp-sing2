    {
      "start": "01:37:37,675",
      "end": "01:37:39,477",
      "text": "Mission accomplished."
    },
    {
      "start": "01:37:39,510",
      "end": "01:37:40,778",
      "text": "We're heading home."
    },
    {
      "start": "01:37:40,811",
      "end": "01:37:44,182",
      "text": "♪ What I'm looking for. ♪"
    },
    {
      "start": "01:38:01,632",
      "end": "01:38:03,601",
      "text": "- Hey, Mr. Moon! - Come on!"
    },
    {
      "start": "01:38:03,634",
      "end": "01:38:05,836",
      "text": "- Get out here, Moon. - Come on out here!"
    },
    {
      "start": "01:38:44,675",
      "end": "01:38:47,145",
      "text": "Jimmy!"
    },
    {
      "start": "01:38:47,179",
      "end": "01:38:50,215",
      "text": "Oh, my gosh, listen to that crowd."
    },
    {
      "start": "01:38:50,248",
      "end": "01:38:52,583",
      "text": "You are a genius."
    },
    {
      "start": "01:38:52,616",
      "end": "01:38:54,618",
      "text": "Yeah, you really are a genius, sir."
    },
    {
      "start": "01:38:55,653",
      "end": "01:38:58,589",
      "text": "Yeah, you got that right, Linda."
    },
    {
      "start": "01:39:01,326",
      "end": "01:39:03,594",
      "text": "Thank you, thank you."
    },
    {
      "start": "01:39:03,627",
      "end": "01:39:06,131",
      "text": "Too kind. I appreciate it, really."
    },
    {
      "start": "01:39:06,164",
      "end": "01:39:08,133",
      "text": "I-I do."
    },
    {
      "start": "01:39:08,166",
      "end": "01:39:10,568",
      "text": "Look, I am very proud of this show."
    },
    {
      "start": "01:39:10,601",
      "end": "01:39:13,205",
      "text": "We did great work here. Great work."
    },
    {
      "start": "01:39:13,238",
      "end": "01:39:17,008",
      "text": "And my good friend, Clay... great to have him back, right?"
    },
    {
      "start": "01:39:17,041",
      "end": "01:39:19,610",
      "text": "Yeah!"
    },
    {
      "start": "01:39:19,643",
      "end": "01:39:22,847",
      "text": "And listen, I look forward to seeing this show run"
    },
    {
      "start": "01:39:22,880",
      "end": "01:39:26,218",
      "text": "at my theater for many, many years to come."
    },
    {
      "start": "01:39:26,251",
      "end": "01:39:28,619",
      "text": "Right, Moon?"
    },
    {
      "start": "01:39:29,587",
      "end": "01:39:31,789",
      "text": "Moon?"
    },
    {
      "start": "01:39:40,165",
      "end": "01:39:43,068",
      "text": "Officers, arrest that wolf."
    },
    {
      "start": "01:39:44,369",
      "end": "01:39:45,803",
      "text": "Wait, wait, wait, wait, wait!"
    },
    {
      "start": "01:39:45,836",
      "end": "01:39:48,005",
      "text": "He's innocent! Mr. Crystal, please!"
    },
    {
      "start": "01:39:48,039",
      "end": "01:39:49,607",
      "text": "I love you!"
    },
    {
      "start": "01:40:01,086",
      "end": "01:40:04,089",
      "text": "♪ Was a Monday morning ♪"
    },
    {
      "start": "01:40:05,656",
      "end": "01:40:08,692",
      "text": "♪ 'Bout a quarter past 4:00 ♪"
    },
    {
      "start": "01:40:10,761",
      "end": "01:40:14,698",
      "text": "♪ You were busy dreaming ♪"
    },
    {
      "start": "01:40:14,732",
      "end": "01:40:18,035",
      "text": "♪ So what did you wake up for? ♪"
    },
    {
      "start": "01:40:20,838",
      "end": "01:40:25,943",
      "text": "♪ Are you a stranger in your own life? ♪"
    },
    {
      "start": "01:40:25,976",
      "end": "01:40:31,216",
      "text": "♪ What are you hiding behind those eyes? ♪"
    },
    {
      "start": "01:40:31,249",
      "end": "01:40:34,685",
      "text": "♪ Is no one looking for you there? ♪"
    },
    {
      "start": "01:40:37,389",
      "end": "01:40:43,027",
      "text": "♪ You know your song saved my life ♪"
    },
    {
      "start": "01:40:43,061",
      "end": "01:40:48,300",
      "text": "♪ I don't sing it just so I can get by ♪"
    },
    {
      "start": "01:40:48,333",
      "end": "01:40:50,368",
      "text": "♪ Won't you hear me ♪"
    },
    {
      "start": "01:40:50,402",
      "end": "01:40:54,306",
      "text": "♪ When I tell you, darlin' ♪"
    },
    {
      "start": "01:40:54,339",
      "end": "01:40:56,208",
      "text": "♪ I sing it to survive ♪"
    },
    {
      "start": "01:40:58,008",
      "end": "01:40:59,244",
      "text": "Stop the bus!"
    },
    {
      "start": "01:41:00,412",
      "end": "01:41:01,946",
      "text": "Whoa!"
    },
    {
      "start": "01:41:01,979",
      "end": "01:41:03,281",
      "text": "- What is it? - What happened?"
    },
    {
      "start": "01:41:03,315",
      "end": "01:41:04,748",
      "text": "- What's going on? - Ow!"
    },
    {
      "start": "01:41:04,782",
      "end": "01:41:06,984",
      "text": "I just got a call from The Majestic."
    },
    {
      "start": "01:41:07,017",
      "end": "01:41:08,986",
      "text": "They think your show is fantastic,"
    },
    {
      "start": "01:41:09,019",
      "end": "01:41:11,223",
      "text": "and they want to put it on at their theater."
    },
    {
      "start": "01:41:13,325",
      "end": "01:41:15,860",
      "text": "Well, what do you say, Mr. Calloway?"
    }
