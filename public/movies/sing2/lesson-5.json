      "text": "Oh, come on, he's having a laugh."
    },
    {
      "start": "00:34:11,869",
      "end": "00:34:14,406",
      "text": "That bloke absolutely hates me."
    },
    {
      "start": "00:34:16,174",
      "end": "00:34:17,775",
      "text": "The first week's always tough."
    },
    {
      "start": "00:34:19,777",
      "end": "00:34:21,679",
      "text": "Meena, come and meet your partner."
    },
    {
      "start": "00:34:24,349",
      "end": "00:34:25,916",
      "text": "Won a ton of awards."
    },
    {
      "start": "00:34:43,834",
      "end": "00:34:45,270",
      "text": "That's really great, Darius."
    },
    {
      "start": "00:34:47,805",
      "end": "00:34:50,142",
      "text": "I'm sure you heard of it... Hope Against Hope."
    },
    {
      "start": "00:34:58,416",
      "end": "00:34:59,950",
      "text": "Oh, yeah. Yeah, yeah, yeah."
    },
    {
      "start": "00:35:05,423",
      "end": "00:35:08,692",
      "text": "M-My name, it's Meena, not Gina."
    },
    {
      "start": "00:35:30,482",
      "end": "00:35:33,050",
      "text": "This song is not helping her at all."
    },
    {
      "start": "00:35:51,902",
      "end": "00:35:53,837",
      "text": "Uh, he'll be here very soon."
    },
    {
      "start": "00:37:28,932",
      "end": "00:37:31,035",
      "text": "Is anybody home?"
    },
    {
      "start": "00:38:38,670",
      "end": "00:38:40,305",
      "text": "Miss Crawly, it's me, Mr. Moon."
    },
    {
      "start": "00:38:42,140",
      "end": "00:38:43,508",
      "text": "I'm starting to worry here."
    },
    {
      "start": "00:38:52,317",
      "end": "00:38:54,686",
      "text": "I'm just messing with you."
    },
    {
      "start": "00:38:58,256",
      "end": "00:39:00,392",
      "text": "Anyway, this is my daughter Porsha."
    },
    {
      "start": "00:39:05,330",
      "end": "00:39:08,199",
      "text": "Oh, my gosh, I'm, like, so into vintage right now."
    },
    {
      "start": "00:39:11,302",
      "end": "00:39:13,971",
      "text": "I-I'm not expecting Clay on set just yet."
    },
    {
      "start": "00:39:17,040",
      "end": "00:39:19,544",
      "text": "Uh, sci-fi? Yes. Yes, it is."
    },
    {
      "start": "00:39:29,320",
      "end": "00:39:31,556",
      "text": "Yeah, yeah, yeah, yeah. You go and do your rehearsing thing."
    },
    {
      "start": "00:39:45,035",
      "end": "00:39:46,571",
      "text": "She sure is."
    },
    {
      "start": "00:40:26,110",
      "end": "00:40:29,046",
      "text": "Believe me, there's nothing Rosita can't do."
    },
    {
      "start": "00:40:41,526",
      "end": "00:40:43,261",
      "text": "What's going on up here?"
    },
    {
      "start": "00:40:44,596",
      "end": "00:40:46,097",
      "text": "Ooh. Can I try?"
    },
    {
      "start": "00:40:49,100",
      "end": "00:40:51,769",
      "text": "Daddy, he won't let me jump!"
    },
    {
      "start": "00:40:55,840",
      "end": "00:40:58,576",
      "text": "Whoa, hey. Uh, just a minute."
    },
    {
      "start": "00:41:06,818",
      "end": "00:41:08,686",
      "text": "All right, let's get you down, Rosita."
    },
    {
      "start": "00:41:10,355",
      "end": "00:41:13,324",
      "text": "This is exactly like the dream I had last night."
    },
    {
      "start": "00:41:16,194",
      "end": "00:41:19,130",
      "text": "And you and you and that funny-looking guy over there."
    }
