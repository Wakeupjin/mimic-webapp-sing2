    },
    {
      "start": "00:05:40,291",
      "end": "00:05:42,660",
      "text": "Well, that's proof, right? She must like the show."
    },
    {
      "start": "00:05:44,429",
      "end": "00:05:46,164",
      "text": "All right, now, keep up the good work."
    },
    {
      "start": "00:05:46,197",
      "end": "00:05:47,998",
      "text": "Come on, everybody, back to positions."
    },
    {
      "start": "00:05:50,134",
      "end": "00:05:52,137",
      "text": "Dream big dreams."
    },
    {
      "start": "00:05:52,170",
