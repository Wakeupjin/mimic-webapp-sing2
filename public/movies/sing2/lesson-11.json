    },
    {
      "start": "01:22:36,841",
      "end": "01:22:38,076",
      "text": "Take it off now!"
    },
    {
      "start": "01:22:44,815",
      "end": "01:22:46,617",
      "text": "Uh, we'll be at the theater soon, sir."
    },
    {
      "start": "01:22:46,650",
      "end": "01:22:48,652",
      "text": "I don't want to be there soon. I want to be there now."
    },
    {
      "start": "01:22:48,686",
