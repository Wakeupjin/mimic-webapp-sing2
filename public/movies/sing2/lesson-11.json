      "text": "♪ 'Cause you light up the path ♪"
    },
    {
      "start": "01:21:49,593",
      "end": "01:21:51,996",
      "text": "That's my boy."
    },
    {
      "start": "01:21:53,065",
      "end": "01:21:55,100",
      "text": "♪ I don't care ♪"
    },
    {
      "start": "01:21:55,133",
      "end": "01:21:58,803",
      "text": "♪ Go on and tear me apart ♪"
    },
    {
      "start": "01:22:00,604",
