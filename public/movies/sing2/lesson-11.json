      "text": "♪ I don't care if you do ♪"
    },
    {
      "start": "01:22:05,009",
      "end": "01:22:08,512",
      "text": "♪ Ooh ♪"
    },
    {
      "start": "01:22:08,546",
      "end": "01:22:10,614",
      "text": "♪ 'Cause in a sky ♪"
    },
    {
      "start": "01:22:10,648",
