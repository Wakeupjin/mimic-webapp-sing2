      "text": "♪ I think I saw you! ♪"
    },
    {
      "start": "01:24:49,039",
      "end": "01:24:51,143",
      "text": "This is Barry. Come in. Over."
    },
    {
      "start": "01:24:51,176",
      "end": "01:24:52,743",
      "text": "Yeah, go ahead, Barry."
    },
    {
      "start": "01:24:52,776",
      "end": "01:24:53,978",
      "text": "Crystal's on site."
    },
    {
      "start": "01:24:54,011",
      "end": "01:24:56,680",
      "text": "Repeat, Crystal is on site. Over."
    },
    {
      "start": "01:24:56,714",
      "end": "01:24:57,982",
      "text": "Roger that."
    },
    {
      "start": "01:24:58,015",
      "end": "01:25:00,684",
      "text": "Right, let's go to work."
    },
    {
      "start": "01:25:00,718",
      "end": "01:25:02,154",
      "text": "Mission report."
    },
    {
      "start": "01:25:02,187",
      "end": "01:25:04,755",
      "text": "My search takes me to the second planet,"
    },
    {
      "start": "01:25:04,788",
      "end": "01:25:05,923",
      "text": "the Planet of Joy."
    },
    {
      "start": "01:25:05,956",
      "end": "01:25:07,758",
      "text": "All right. Here we go, Porsha."
    }
