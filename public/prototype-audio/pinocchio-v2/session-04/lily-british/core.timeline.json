  "lines": [
    {
      "id": "line-01",
      "text": "Fire Eater gave Pinocchio five gold pieces to carry home to Geppetto.",
      "start": 0.091,
      "end": 5.117
    },
    {
      "id": "line-02",
      "text": "The puppet imagined food, clothing, and a new coat for his father.",
      "start": 5.117,
      "end": 10.973
    },
    {
      "id": "line-03",
      "text": "On the road, a limping Fox and supposedly blind Cat approached him.",
      "start": 10.973,
      "end": 17.163
    },
    {
      "id": "line-04",
      "text": "They described a magical field where buried coins would multiply overnight.",
      "start": 17.163,
      "end": 23.262
    },
    {
      "id": "line-05",
      "text": "A Blackbird exposed the story as a trick and urged Pinocchio home.",
      "start": 23.262,
      "end": 28.707
    },
    {
      "id": "line-06",
      "text": "The Cat quickly silenced the bird before the warning could sink in.",
      "start": 28.707,
      "end": 33.969
    },
    {
      "id": "line-07",
      "text": "Pinocchio chose the exciting promise and followed them to the Red Lobster Inn.",
      "start": 33.969,
      "end": 39.437
    },
    {
      "id": "line-08",
      "text": "His new friends ordered an enormous meal while pretending to be unwell.",
      "start": 39.437,
      "end": 45.171
    },
    {
      "id": "line-09",
      "text": "Before midnight, they disappeared and left Pinocchio responsible for the bill.",
      "start": 45.171,
      "end": 51.005
    },
    {
      "id": "line-10",
      "text": "After paying one coin, he continued alone along the dark road.",
      "start": 51.005,
      "end": 56.201
    },
    {
      "id": "line-11",
      "text": "The ghost of the Talking Cricket offered one final warning to return.",
      "start": 56.201,
      "end": 61.774
    },
    {
      "id": "line-12",
      "text": "Two masked Assassins appeared and chased Pinocchio deep into the forest.",
      "start": 61.774,
      "end": 68.069
    },
    {
      "id": "line-13",
      "text": "He hid the remaining four coins beneath his tongue and refused to speak.",
      "start": 68.069,
      "end": 73.516
    },
    {
      "id": "line-14",
      "text": "After a desperate escape, he raced toward a distant white house.",
      "start": 73.516,
      "end": 79.75
    },
    {
      "id": "line-15",
      "text": "The Assassins caught him near a giant oak when the door stayed closed.",
      "start": 79.75,
      "end": 85.126
    },
    {
      "id": "line-16",
      "text": "They left him suspended from a branch while the violent wind rose.",
      "start": 85.126,
      "end": 90.258
    }
  ],
