                        textAlign: 'center',
                        fontFamily: '"Jolly Lodger"',
                        fontSize: '48px',
                        fontStyle: 'normal',
                        fontWeight: '400',
                        lineHeight: 'normal'
                      }}
                    >
                      #MimiC
                    </p>
                  </div>
                </div>
              </div>
            </div>
