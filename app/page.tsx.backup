                        >
                          <span style={{ fontFamily: 'var(--font-bm-hanna-pro), sans-serif', fontWeight: '300' }}>혼자도 좋아 같이 하면 더 좋아</span>
                          <span className="text-white text-8xl mr-4 transition-all duration-300">{activeModal === 'menu3' ? '×' : '+'}</span>
