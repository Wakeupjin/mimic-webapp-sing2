                  </div>
                  
                  {/* 하단 소셜 미디어 섹션 */}
                  <div className="text-center mt-6 p-4 h-32 flex flex-col justify-center">
                    <p className="text-white text-sm mb-4">다른 곳에서도 만나요.</p>
                    <div className="flex space-x-4 justify-center">
