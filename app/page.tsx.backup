                          }}
                        >
                          <span style={{ fontFamily: 'var(--font-bm-hanna-pro), sans-serif', fontWeight: '300' }}>내 주변 미믹 플레이스</span>
                          <span className="text-white text-8xl mr-4 transition-all duration-300">{activeModal === 'menu4' ? '×' : '+'}</span>
                        </a>
                        {activeModal === 'menu4' && (
                            <div className="w-full bg-black p-6 rounded-lg shadow-lg mt-2 animate-in slide-in-from-left-4 fade-in" style={{ animationDuration: '800ms', animationTimingFunction: 'cubic-bezier(0.4, 0, 0.2, 1)' }}>
                            <div className="grid grid-cols-3 gap-2 animate-in slide-in-from-left-4 fade-in" style={{ animationDuration: '1000ms', animationTimingFunction: 'cubic-bezier(0.4, 0, 0.2, 1)', animationDelay: '200ms' }}>
                              <div className="bg-gray-800 h-12 rounded-lg flex items-center justify-center">
