                            <div className="grid grid-cols-3 gap-2 animate-in slide-in-from-left-4 fade-in" style={{ animationDuration: '1000ms', animationTimingFunction: 'cubic-bezier(0.4, 0, 0.2, 1)', animationDelay: '200ms' }}>
