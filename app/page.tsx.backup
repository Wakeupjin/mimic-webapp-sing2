                        >
                          <span style={{ fontFamily: 'var(--font-bm-hanna-pro), sans-serif', fontWeight: '300' }}>더욱 재밌고 다양한 콘텐츠</span>
                          <span className="text-white text-8xl mr-4 transition-all duration-300">{activeModal === 'menu2' ? '×' : '+'}</span>
                        </a>
                        {activeModal === 'menu2' && (
